# Default: keep text files normalized in the repository.
* text=auto

# Shell / Python / docs must keep LF even on Windows checkouts.
*.sh text eol=lf
*.bash text eol=lf
*.py text eol=lf
*.md text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.json text eol=lf
*.jsonl text eol=lf
*.tsv text eol=lf
*.conf text eol=lf
*.gitignore text eol=lf
*.gitattributes text eol=lf

# Binary assets (if added later) should not be normalized.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.pdf binary
*.zip binary
*.gz binary
