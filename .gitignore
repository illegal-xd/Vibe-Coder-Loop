# Local tool indexes
.codegraph/

# Legacy runtime state (v1.22 and earlier; never publish)
# 当前协议把 Workflow Checkpoint 存 delx-memory（vc:checkpoint:<项目绝对地址>），
# 不再创建项目内状态文件；此处保留忽略以防旧实例残留被提交。
.vibe-kernel/
# 遗留位置（v1.22 之前；仅供本机旧实例继续被忽略）
skills/vibe-coder-loop/.state.md
skills/vibe-coder-loop/backup/snapshots/*
!skills/vibe-coder-loop/backup/snapshots/.gitignore
# 本机生成的脱敏规则集（规则内容不入库：隐私约束；仅在私有通道内分发）
skills/vibe-coder-loop/backup/rules/

# Local audit outputs that may contain unredacted or environment-specific evidence
docs/audits/scan-report.local.*
docs/audits/*.local.tsv
docs/audits/*.local.jsonl

# External tool artifacts (Aspire Code etc.)
.aspirecode/
# 生成型审计/提炼 JSON（可由 scripts/memory/{audit_memory,distill}.py 复现，入库会造成数据噪声）
reports/memory-audit-*.json
reports/memory-distill-*.json

# 记忆查看器数据快照（含本机路径与记忆正文，禁止入库；用 scripts/memory/export_viewer_data.py 生成）
tools/memory-viewer/memory-data.json

# Skill 草稿（来自本机记忆的候选产物；默认不入库，评审后再人工移入 skills/）
reports/skill-drafts/
